{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/command/**",
              "components/core/**",
              "components/feedback/**",
              "components/icon/**",
              "components/inspector/**",
              "components/telemetry/**",
              "ui_kits/obsidian-ide/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|shape|dot|leading|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, shape, dot, leading, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:route|telemetry|meta|ok|warn|fault|neutral|solid)$/]",
        "message": "<Badge> tone must be one of 'route' | 'telemetry' | 'meta' | 'ok' | 'warn' | 'fault' | 'neutral' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:tag|pill)$/]",
        "message": "<Badge> shape must be one of 'tag' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|leading|trailing|disabled|fullWidth|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children, leading, trailing, disabled, fullWidth, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|telemetry|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'telemetry' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|items|key|ref|className|style|children)$/]",
        "message": "<CommandGroup> doesn't accept that prop. Declared props: label, meta, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|provider|leading|cost|context|health|alias|badges|selected|dense|onClick|onMouseEnter|style|key|ref|className|style|children)$/]",
        "message": "<CommandRow> doesn't accept that prop. Declared props: name, provider, leading, cost, context, health, alias, badges, selected, dense, onClick, onMouseEnter, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|active|disabled|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, size, active, disabled, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|size|leading|trailing|mono|invalid|disabled|bare|autoFocus|onKeyDown|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, size, leading, trailing, mono, invalid, disabled, bare, autoFocus, onKeyDown, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kbd'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Kbd> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kbd'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent)$/]",
        "message": "<Kbd> tone must be one of 'default' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricPair'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<MetricPair> doesn't accept that prop. Declared props: label, value, unit, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricPair'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|route|telemetry|meta|warn|fault|ok)$/]",
        "message": "<MetricPair> tone must be one of 'default' | 'route' | 'telemetry' | 'meta' | 'warn' | 'fault' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricPair'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<MetricPair> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|actions|tone|rim|padded|children|style|bodyStyle|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, meta, actions, tone, rim, padded, children, style, bodyStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:docked|pane|glass|canvas)$/]",
        "message": "<Panel> tone must be one of 'docked' | 'pane' | 'glass' | 'canvas'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|ping|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: tone, size, ping, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|warn|fault|idle|live|route)$/]",
        "message": "<StatusDot> tone must be one of 'ok' | 'warn' | 'fault' | 'idle' | 'live' | 'route'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|hint|id|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label, hint, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|tone|leading|action|onDismiss|timestamp|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: title, detail, tone, leading, action, onDismiss, timestamp, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|live|cache|warn|fault|ok)$/]",
        "message": "<Toast> tone must be one of 'info' | 'live' | 'cache' | 'warn' | 'fault' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TokenBudgetBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:used|cached|total|label|showValues|height|style|key|ref|className|style|children)$/]",
        "message": "<TokenBudgetBar> doesn't accept that prop. Declared props: used, cached, total, label, showValues, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TreeItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|depth|expanded|onToggle|leading|meta|status|selected|trailing|children|style|key|ref|className|style|children)$/]",
        "message": "<TreeItem> doesn't accept that prop. Declared props: label, depth, expanded, onToggle, leading, meta, status, selected, trailing, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TreeItem'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|warn|fault|idle)$/]",
        "message": "<TreeItem> status must be one of 'ok' | 'warn' | 'fault' | 'idle'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
